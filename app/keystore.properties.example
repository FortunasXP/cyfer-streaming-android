# Copy this file to `app/keystore.properties` (gitignored) and fill in
# your release keystore path + credentials. Or set the same values via
# environment variables:
#   CYFER_KEYSTORE       absolute path to .jks / .keystore
#   CYFER_KEYSTORE_PW    keystore password
#   CYFER_KEY_ALIAS      key alias inside the keystore
#   CYFER_KEY_PW         key password
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore cyfer-release.jks \
#           -keyalg RSA -keysize 4096 -validity 36500 \
#           -alias cyfer-android
#
# Without a configured keystore the release build falls back to the
# debug signing config, so `assembleDebug` always works.

storeFile=/absolute/path/to/cyfer-release.jks
storePassword=changeme
keyAlias=cyfer-android
keyPassword=changeme
